<?xml version="1.0"?>
<ruleset name="eldritch-horror"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>
        Curated PMD rules for Eldritch Horror: the dead/redundant code an IDE flags, so it is
        caught deliberately rather than by eye. Not a style gate — read the report and decide.
    </description>

    <!-- Unused members: the "unused method/property/import" family. -->
    <rule ref="category/java/bestpractices.xml/UnusedPrivateField"/>
    <rule ref="category/java/bestpractices.xml/UnusedPrivateMethod"/>
    <rule ref="category/java/bestpractices.xml/UnusedLocalVariable"/>
    <rule ref="category/java/bestpractices.xml/UnusedAssignment"/>
    <rule ref="category/java/bestpractices.xml/UnusedLabel"/>
    <rule ref="category/java/codestyle.xml/UnnecessaryImport"/>

    <!-- Redundant control flow / expressions. -->
    <rule ref="category/java/codestyle.xml/UnnecessaryReturn"/>
    <rule ref="category/java/codestyle.xml/UselessParentheses"/>
    <rule ref="category/java/codestyle.xml/UnnecessaryModifier"/>
    <rule ref="category/java/codestyle.xml/UnnecessaryConstructor"/>
    <rule ref="category/java/codestyle.xml/UnnecessarySemicolon"/>
    <rule ref="category/java/codestyle.xml/UnnecessaryCast"/>
    <rule ref="category/java/codestyle.xml/EmptyControlStatement"/>
    <rule ref="category/java/codestyle.xml/ExtendsObject"/>
    <rule ref="category/java/errorprone.xml/UnconditionalIfStatement"/>
    <rule ref="category/java/errorprone.xml/EmptyCatchBlock"/>

    <!-- Considered and rejected (kept out deliberately):
         - CloseResource: flags ServerLevel / ServerChunkCache / MinecraftServer (they implement
           AutoCloseable but are engine-owned and must NOT be closed) and even EarthMap.read,
           whose InputStream is already closed by try-with-resources. 76 false positives.
         - GuardLogStatement: fires on every parameterised '{}' log call (~15 sites), which is the
           idiomatic, recommended form. Guarding info/warn adds noise, not safety.
         Revisit only with a curated ignore-list / resource-type restriction. -->
</ruleset>

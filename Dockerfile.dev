# Dev image for Eldritch Horror — JDK 25 + the native libs the dev client needs.
#
# The source is COPIED into the image (not bind-mounted). Docker Desktop on Windows
# cannot share C:\ reliably, so named volumes + a baked-context image is the setup that
# works on every OS. Rebuild the image after changing code.
#
#   docker compose build dev
#   docker compose run --rm dev ./gradlew build
FROM eclipse-temurin:25-jdk-jammy

ARG UID=1000
ARG GID=1000

# Toolchain: the Gradle wrapper downloads Gradle itself. `setpriv` drops privileges in the
# entrypoint. The X11/GL/OpenAL libs are for `./gradlew runClient` (unused for headless).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash git curl ca-certificates procps less util-linux \
      libx11-6 libxext6 libxrender1 libxtst6 libxi6 libxrandr2 \
      libxcursor1 libxinerama1 libxxf86vm1 libgl1 libglu1-mesa \
      libopenal1 libpulse0 \
 && rm -rf /var/lib/apt/lists/*

# Create a user matching the host; tolerate a base image that already owns the ids.
RUN set -eux; \
    if ! getent group "${GID}" >/dev/null; then groupadd -g "${GID}" dev; fi; \
    if ! getent passwd "${UID}" >/dev/null; then useradd -m -u "${UID}" -g "${GID}" -s /bin/bash dev; fi; \
    install -d -o "${UID}" -g "${GID}" /workspace /home/dev/.gradle

# Entrypoint that strips a CRLF from gradlew (Windows checkouts) before running.
COPY docker-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

ENV HOME=/home/dev \
    GRADLE_USER_HOME=/home/dev/.gradle

WORKDIR /workspace

# Source baked in (no host bind mount). Owned by the dev user.
COPY --chown=${UID}:${GID} . /workspace
RUN chmod +x gradlew && sed -i 's/\r$//' gradlew

# Create the volume mount points owned by the dev user. A freshly created named
# volume inherits the ownership of the image directory it mounts over; without this
# the volumes are root-owned and Gradle cannot write /workspace/build or /workspace/run.
RUN mkdir -p /workspace/build /workspace/run /home/dev/.gradle \
 && chown -R "${UID}:${GID}" /workspace/build /workspace/run /home/dev/.gradle

# Stay root at entry so the entrypoint can fix named-volume ownership, then drop to the
# dev user (see docker-entrypoint.sh). DEV_UID/DEV_GID tell it who to drop to.
ENV DEV_UID=${UID} \
    DEV_GID=${GID}
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["sleep", "infinity"]
